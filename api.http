Authorization: Bearer {{apiKey}}
Content-Type: multipart/form-data; boundary=----boundary

------boundary
Content-Disposition: form-data; name="image"; filename="sample.jpg"
Content-Type: image/jpeg

< {{testImage}}
------boundary
Content-Disposition: form-data; name="width"

300
------boundary
Content-Disposition: form-data; name="height"

300
------boundary
Content-Disposition: form-data; name="format"

webp
------boundary--

### -------------------------------------------------------------------
### GET /process — unsigned (only works when SIGNING_KEY is empty;
## the server is on a private network / open-by-default). For signed
## usage, generate a URL with `go run ./cmd/gensig -key=<your-key>
## -exp=24h 'src=...&w=...'` and paste it below.
### -------------------------------------------------------------------
# Example unsigned (dev / trusted-network only):
GET {{baseUrl}}/process?src=https%3A%2F%2Fexample.com%2Fphoto.jpg&w=800&format=webp&q=80
Accept: image/webp

### -------------------------------------------------------------------
### GET /process — signed (sample; sig/exp become invalid over time.
## Regenerate with: go run ./cmd/gensig -key=$SIGNING_KEY -exp=24h
## 'src=https%3A%2F%2Fexample.com%2Fphoto.jpg&w=800&format=webp&q=80'
### -------------------------------------------------------------------
# GET {{baseUrl}}/process?src=...&w=800&format=webp&q=80&exp=1700000000&sig=REPLACE_ME
# Accept: image/webp
